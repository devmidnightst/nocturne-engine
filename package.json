{
  "name": "umbrella",
  "version": "1.0.0",
  "description": "Umbrella: a Scramjet 2.x web proxy with a hardened rewriter layer, a plain UI and a PM2 ready Node server.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node --watch src/server.js",
    "check": "node src/check.js",
    "test": "node --test \"test/*.test.js\"",
    "test:e2e": "node scripts/e2e.mjs",
    "test:soak": "node scripts/soak.mjs",
    "pm2": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs"
  },
  "dependencies": {
    "@mercuryworkshop/epoxy-transport": "3.0.1",
    "@mercuryworkshop/libcurl-transport": "2.0.5",
    "@mercuryworkshop/proxy-transports": "1.0.2",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@mercuryworkshop/scramjet-utils": "0.0.3",
    "@mercuryworkshop/wisp-js": "0.5.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "crypto-random-string": "^6.0.0",
    "express": "5.2.1",
    "ipaddr.js": "2.5.0"
  },
  "devDependencies": {
    "playwright-core": "1.55.0",
    "ws": "8.22.0"
  }
}
