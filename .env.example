# nocturne engine config. copy to .env and edit. real env vars win over this file.

# where node listens. keep it on 127.0.0.1 behind caddy.
HOST=127.0.0.1
PORT=8080

# which proxies to trust for x-forwarded-for. "loopback" = caddy on the same box.
TRUST_PROXY=loopback

# ---- wisp (the websocket tunnel epoxy and libcurl use) ----
WISP_PATH=/wisp/
# ssrf guards. leave these off on a public server, they stop the proxy from
# reaching the vps itself, your homelab or cloud metadata endpoints.
WISP_ALLOW_PRIVATE_IPS=false
WISP_ALLOW_LOOPBACK_IPS=false
# browsers never need udp through wisp, only turn on if you know why
WISP_ALLOW_UDP=false
# smtp ports are blocked so nobody sends spam from your ip
WISP_PORT_BLACKLIST=25,465,587
# -1 = unlimited. per wisp connection (one browser tab)
WISP_STREAM_LIMIT_PER_HOST=-1
WISP_STREAM_LIMIT_TOTAL=-1
# only let pages from these origins open wisp sockets (stops bandwidth hotlinking).
# comma separated, exact origins. empty = allow any.
# WISP_ALLOWED_ORIGINS=https://nocturne.lol,https://www.nocturne.lol
# custom resolvers for the wisp server, comma separated
# WISP_DNS_SERVERS=1.1.1.1,9.9.9.9
# biggest websocket frame a client may send to the wisp endpoint
WISP_MAX_FRAME_BYTES=4194304
WISP_LOG_LEVEL=WARN

# ---- custom domains / caddy on_demand_tls ----
# hostnames caddy may get certs for, wildcards like *.nocturne.lol work
TLS_ALLOWED_DOMAINS=nocturne.lol,*.nocturne.lol
# optional file, one hostname per line, re-read on change
# TLS_DOMAINS_FILE=deploy/domains.txt

# ---- debugging ----
# serve stock scramjet bundles: all, or a comma list of patch ids
# NOCTURNE_DISABLE_PATCHES=all
